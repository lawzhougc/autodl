#!/bin/bash
# 安装后回调: 检查并引导补齐运行依赖
#
# 依赖分三类:
#   1) fnOS 应用: guangyapan(光鸭云盘) / jackett —— 已在 manifest 的 install_dep_apps 声明，
#      系统会自动安装；这里做二次确认并尝试启动
#   2) Docker 容器: flaresolverr —— 可选，仅 uindex.org 用；这里给出明确的部署指令
#   3) 系统命令: python3 / aria2c / ffmpeg / ffprobe —— 缺失时给出安装方式
#
# 说明: 依赖缺失不应阻断安装，所以本脚本始终 exit 0，把结论写进安装日志，
#      用户也能在终端随时重跑 server/bin/depcheck 复检。

LOG="${TRIM_TEMP_LOGFILE:-/dev/null}"
DEPCHECK="${TRIM_APPDEST}/server/bin/depcheck"
VAR_DIR="${TRIM_PKGVAR}"

{
    echo
    echo "================================================================"
    echo " 影视资源自动追踪控制台 · 安装后依赖检查"
    echo "================================================================"
    echo

    # ---- 1. fnOS 应用依赖: 确认已安装并尝试启动 ----
    echo "--- 检查 fnOS 应用依赖 ---"
    for app in guangyapan jackett; do
        case "$app" in
            guangyapan) label="光鸭云盘" ;;
            jackett)    label="Jackett" ;;
        esac

        if ! command -v trim-cli >/dev/null 2>&1; then
            echo "  [跳过] trim-cli 不可用，无法自动检测 $label"
            continue
        fi

        STATE=$(trim-cli app status "$app" 2>/dev/null \
            | python3 -c "import json,sys
try:
    d=json.load(sys.stdin)
    print((d.get('data') or d).get('status') or 'unknown')
except Exception:
    print('unknown')" 2>/dev/null)

        if [ -z "$STATE" ] || [ "$STATE" = "unknown" ] || [ "$STATE" = "not_installed" ]; then
            echo "  [缺失] $label ($app) 未安装，尝试安装..."
            if trim-cli app install "$app" --yes >>"$LOG" 2>&1; then
                echo "  [已装] $label 安装完成"
                STATE="stopped"
            else
                echo "  [失败] $label 自动安装失败，请到应用中心手动安装"
                continue
            fi
        else
            echo "  [已装] $label (状态: $STATE)"
        fi

        if [ "$STATE" = "stopped" ] || [ "$STATE" = "nostart" ]; then
            echo "         正在启动 $label ..."
            trim-cli app start "$app" --yes >>"$LOG" 2>&1 \
                && echo "         [已启动]" \
                || echo "         [启动失败] 请到应用中心手动启动"
        fi
    done
    echo

    # ---- 2. 系统命令 + 服务端口连通性 ----
    if [ -x "$DEPCHECK" ]; then
        "$DEPCHECK" 2>&1
        RC=$?
    else
        echo "  [异常] 未找到依赖检查脚本 $DEPCHECK"
        RC=1
    fi
    echo

    # ---- 3. 给用户的收尾提示 ----
    echo "================================================================"
    echo " 后续必做（否则应用无法真正下载）"
    echo "================================================================"
    echo " 1. 打开「光鸭网盘」应用，扫码登录（首次安装必须）"
    echo "     未登录时 /api/user 会返回 is_logged_in=false"
    echo
    echo " 2. 打开 Jackett (http://<nas-ip>:9117) 添加索引器："
    echo "     推荐 thepiratebay / knaben / therarbg / limetorrents /"
    echo "          torrentgalaxyclone / uindex"
    echo "     不加索引器则搜索不到任何资源"
    echo
    echo " 3. （可选）启用 FlareSolverr 以支持 uindex.org："
    echo "     cd ${TRIM_APPDEST}/server/flaresolverr && docker compose up -d"
    echo "     然后在 Jackett 的 ServerConfig.json 中设置"
    echo "     FlareSolverrUrl = http://127.0.0.1:8191 并重启 Jackett"
    echo
    echo " 4. 打开控制台 http://<nas-ip>:8770 登记想看的剧或电影"
    echo
    echo " 随时重新检查依赖： $DEPCHECK"
    echo

    if [ "$RC" != "0" ]; then
        echo " ⚠️  有依赖尚未就绪，请按上面的提示处理后再使用。"
    else
        echo " ✅ 依赖检查通过。"
    fi
    echo "================================================================"
} >> "$LOG" 2>&1

exit 0
