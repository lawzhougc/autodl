appname="autodl"
version="0.2.14"
display_name="影视资源自动追踪控制台"
desc="影视资源自动追踪与下载系统。给定美剧或电影名称，自动完成「多源搜索 → 网盘离线下载 → 下载到 NAS → 自动中文字幕」的完整链路，并持续追踪更新，新集上线即自动下载。支持 6 个 Jackett 索引器 + bt4g 并行搜索，优先 2160p，中文片名自动识别，下载节奏与资源筛选偏好可调。需配合光鸭云盘 App（8998 端口）与 Jackett（9117 端口）使用。"
platform="x86"
source="thirdparty"
maintainer="lawzhougc"
maintainer_url="https://github.com/lawzhougc/autodl"
distributor="lawzhougc"
distributor_url="https://github.com/lawzhougc/autodl"
desktop_uidir="ui"
desktop_applaunchname="autodl.Application"
service_port="8770"
checkport="false"
install_type="root"
install_dep_apps="guangyapan:jackett"
disable_authorization_path="false"
ctl_stop="true"
changelog="0.2.14: 修复直接提交带种子链接的资源时被误当磁链导致光鸭解析报错无可选视频文件的缺陷；增加纯 Python Bencode 种子解析与 infohash/tracker 自动提取；增加种子预解析结果复用；优化前后端透传与单文件大视频容错；0.2.13: 修复搜索结果点击靠后项目误下第一条的问题，支持精准下载指定文件；修复光鸭网盘和NAS落地视频缺少扩展名问题；修复下载到NAS后被误判失败的缺陷，增强完成状态检测；集成原生fnpack一键打包；0.2.12: 修复追剧进度保存失败缺陷；增加整季完结后新季自动探测与跨季追踪；实现电影心愿后台周期追踪与4K上线自动下载；新增射手网开放API免账号字幕引擎；0.2.11: 解决光鸭网盘部分版本创建文件夹接口报「文件夹名不能为空」阻断任务的问题；0.2.10: 修复特殊字符过滤与登录态校验。"
